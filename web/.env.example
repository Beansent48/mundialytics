# Copy to web/.env.local and fill in. `.env.local` is never committed.
#
# Nothing below is needed to read the site: every football page renders for a
# visitor who never signs in. These are only the account layer's keys.

# --- Database -----------------------------------------------------------
# The Postgres from docker-compose.yml at the repo root. The default compose
# credentials are mundialytics/mundialytics on port 5432.
DATABASE_URL=

# --- Session ------------------------------------------------------------
# Signs and encrypts session cookies. Treat it like a database password; a new
# value signs every existing session out. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# The origin the browser reaches the app on. http://localhost:3000 in
# development; the public https origin once the site is deployed.
BETTER_AUTH_URL=

# --- Google sign-in -----------------------------------------------------
# From a Google Cloud OAuth 2.0 client of type "Web application". The exact
# steps, and the redirect URI it needs, are in docs/USER_ACCOUNTS_DESIGN.md §9.
# Leave both empty and the Google button simply does not appear; email
# sign-in still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email --------------------------------------------------------------
# Verification links are printed to the server log while no mail transport is
# configured (see web/lib/mail.ts). Set this to 1 to refuse sign-in until the
# address is verified; leave it empty in development, where the only way to
# reach the link is the terminal.
AUTH_REQUIRE_EMAIL_VERIFICATION=
