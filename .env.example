# Copy to `.env` (never committed) before the first `docker compose up`.
#
# Compose reads this file automatically; every value below has a default in
# docker-compose.yml, except BETTER_AUTH_SECRET, which the web container refuses
# to start without. Running locally, the only line you have to fill is that one.
#
# `web/.env.example` is the other half: the same account keys for running
# `next dev` and `drizzle-kit` on the host, outside containers.

# --- Where the data is ---------------------------------------------------
# Mounted at /app/data in the api and refresh containers. The default is the
# repo's own data/, which is what a single-machine deployment wants. Point it
# somewhere else when the data lives on another disk or another volume.
DATA_DIR=./data
# Who the api and refresh containers run as. On Linux a bind mount keeps the
# host's ownership, so these have to be the owner of DATA_DIR or the containers
# cannot write their caches, the fixture snapshots or the refreshed data:
#   DATA_UID=$(id -u)   DATA_GID=$(id -g)
# The image's own user is 10001; `chown -R 10001:10001 data/` is the other
# answer. Docker Desktop on Windows and macOS ignores all of this.
DATA_UID=10001
DATA_GID=10001

# --- Time ----------------------------------------------------------------
# Explicit, because kickoff rendering and the "today" window of /fixtures/day
# are date-sensitive: a container on UTC shows a 21:00 Sunday kickoff as
# Monday's match.
TZ=Europe/Madrid

# --- The public address --------------------------------------------------
# `:80` serves plain HTTP on every interface, which is what you want locally.
# A hostname (`mundialytics.example`) makes Caddy fetch and renew a Let's
# Encrypt certificate by itself — only set one once the DNS A record points
# here, or the ACME challenge fails and gets rate-limited.
SITE_ADDRESS=:80
ACME_EMAIL=
# Where Caddy listens on the host. 80/443 in a deployment; change them if
# something else on the machine already holds those ports.
HTTP_PORT=80
HTTPS_PORT=443

# --- The API -------------------------------------------------------------
# Published on loopback only: the browser reaches the API through Caddy at
# /engine, and this port exists for the `web` image build (which prerenders
# every data page against a live API) and for poking it by hand.
API_PORT=8000
# Browser origins allowed to call the API cross-origin. Empty is correct for
# this stack — the site is one origin — and is NOT the same as unset, which
# means "development" and allows any localhost port. See api/main.py.
API_CORS_ORIGINS=

# --- Accounts ------------------------------------------------------------
POSTGRES_USER=mundialytics
POSTGRES_PASSWORD=mundialytics
POSTGRES_DB=mundialytics
POSTGRES_PORT=5432
# The two containers that talk to Postgres (`web` and `migrate`) reach it by
# service name, not through the published port above.
DATABASE_URL=postgres://mundialytics:mundialytics@postgres:5432/mundialytics

# Signs and encrypts session cookies; an empty value stops the web container
# rather than falling back to a published default. A new value signs everyone
# out. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# The origin the browser reaches the app on — http://localhost for the local
# stack, https://your-domain once SITE_ADDRESS is a hostname.
BETTER_AUTH_URL=http://localhost
# Leave both empty and the Google button simply does not appear; email sign-in
# still works. docs/USER_ACCOUNTS_DESIGN.md §9 has the Google Cloud steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_REQUIRE_EMAIL_VERIFICATION=

# --- The daily refresh ---------------------------------------------------
# It runs inside the stack (option b of docs/DEPLOYMENT_PLAN.md). Local time,
# per TZ above.
REFRESH_AT=10:00
# The weekday that also passes --full (the ~15 min walk-forward regeneration
# behind the Resultados page). `never` for none, `daily` for every run.
REFRESH_FULL_DAY=Monday
# 1 refreshes once at startup instead of waiting for the next slot. Useful to
# test the container, expensive to leave on: every restart downloads a season.
REFRESH_ON_START=0
# Extra arguments for scripts/update_season.py, e.g. --skip-understat.
REFRESH_ARGS=

# --- Shared between the refresh and the web app --------------------------
# Required in this stack, not optional. /api/revalidate accepts an unauthorised
# call only from a localhost Host header, and the refresh container's Host is
# `web`, so without a secret here the post-refresh invalidation answers 401 and
# the new matchday waits out each page's own revalidate window. The refresh
# container says so in its log at startup. Any random string; the same value is
# passed to both services.
REVALIDATE_SECRET=

# --- Search engines ------------------------------------------------------
# Empty keeps robots.txt at Disallow and the pages at noindex: public, but not
# findable. Set to 1 the day the site should be indexed.
SITE_INDEXABLE=
