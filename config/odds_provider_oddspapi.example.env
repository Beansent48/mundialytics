# Mundialytics v0.42 OddsPapi / RapidAPI configuration
# Keep real keys out of git/zips.

# Direct provider mode (recommended if you have a key from oddspapi.io):
ODDSPAPI_MODE=direct
ODDSPAPI_API_KEY=YOUR_ODDSPAPI_KEY
ODDSPAPI_BASE_URL=https://v5.oddspapi.io/en

# RapidAPI marketplace mode:
# Copy host/base URL from the RapidAPI code snippet for the exact API listing.
# ODDSPAPI_MODE=rapidapi
# RAPIDAPI_KEY=YOUR_RAPIDAPI_KEY
# RAPIDAPI_ODDSPAPI_HOST=YOUR_RAPIDAPI_HOST_FROM_CODE_SNIPPET
# ODDSPAPI_BASE_URL=YOUR_RAPIDAPI_BASE_URL_FROM_CODE_SNIPPET
